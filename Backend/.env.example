# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Secret used to sign JWTs. MUST be a random string of at least 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_32_char_min_secret

# Port the API server listens on (optional, defaults to 3000)
PORT=3000

# Comma-separated list of allowed CORS origins (optional, defaults to http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# Base URL of the frontend, used to build invite links (optional, defaults to http://localhost:5173)
FRONTEND_URL=http://localhost:5173
